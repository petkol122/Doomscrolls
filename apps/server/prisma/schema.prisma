generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ItemLocationType {
  ROOM_LOOT
  INVENTORY
  STASH
  EQUIPMENT
  CORPSE_BOUND
  DELETED
}

enum CorpseStatus {
  ACTIVE
  RECOVERED
}

model User {
  id                 String         @id @default(uuid())
  username           String
  usernameNormalized String         @unique
  passwordHash       String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  lastSeenAt         DateTime?

  profile    UserProfile?
  settings   UserSettings?
  sessions   Session[]
  characters Character[]
  stashItems StashItem[]

  @@index([usernameNormalized])
}

model Session {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String        @unique
  status    SessionStatus
  createdAt DateTime      @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  avatarKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id             String   @id @default(uuid())
  userId         String   @unique
  masterVolume   Float    @default(0.8)
  musicVolume    Float    @default(0.6)
  sfxVolume      Float    @default(0.8)
  showFpsCounter Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id                      String   @id @default(uuid())
  userId                  String
  characterName           String
  characterNameNormalized String
  originId                String
  classId                 String
  level                   Int      @default(1)
  xp                      Int      @default(0)
  currentZoneId           String
  currentHp               Int
  // Milestone 0.3 -- 4-Slot Flask Belt. JSON-encoded array of up to 4
  // persisted charge counts, one per belt slot (index 0 = flask_1 ...
  // index 3 = flask_4), matching the existing `walletBalancesJson`/
  // `materialBalancesJson` JSON-column convention. Replaces the old
  // single `currentFlaskCharges` counter now that charges are tracked
  // per-slot. See `packages/shared/src/inventory/FlaskBeltPersistence.ts`.
  flaskChargesJson        String   @default("[]")
  // Core 0.1 Foundation -- Skill Point Allocation. Unallocated points
  // (1 gained per level) and the persisted rank of each of the
  // character's three skill slots. Every skill starts at rank 1
  // (already castable); points raise a slot's rank up to that skill's
  // content-defined maxRank. Mana is NOT persisted here -- it always
  // resets to full on join/respawn (see PlayerPresence), so it needs
  // no DB column.
  skillPoints             Int      @default(0)
  primarySkillRank        Int      @default(1)
  secondarySkillRank      Int      @default(1)
  tertiarySkillRank       Int      @default(1)
  lastLocationZoneId      String?
  lastLocationX           Float?
  lastLocationY           Float?
  moneyCopper             Int      @default(0)
  // Milestone 0.3 -- Multi-Currency Wallet Engine. JSON-encoded map of
  // non-CZK currency balances (eur/usd/rmb/jpy/gold_bullion/street_cred).
  // `moneyCopper` above remains the CZK balance (see CurrencyTypes.ts
  // `buildCharacterWallet`); stored as TEXT rather than a native Json
  // column to match the existing `ItemInstance.rolledAffixes` convention.
  walletBalancesJson      String   @default("{}")
  // Milestone 0.3 -- Profession Training System. JSON-encoded map of
  // profession id -> tier reached (see ProfessionTypes.ts
  // `parseProfessionsJson`/`buildProfessionsJson`); stored as TEXT for
  // the same reason as `walletBalancesJson` above.
  professionsJson         String   @default("{}")
  // Salvage-material currency balances (Iron Scrap / Arcane Dust). JSON-
  // encoded map of MaterialId -> quantity (see MaterialTypes.ts
  // `parseMaterialBalancesJson`/`buildMaterialBalances`); stored as TEXT
  // for the same reason as `walletBalancesJson` above.
  materialBalancesJson    String   @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  lastPlayedAt            DateTime?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats     CharacterStats?
  passives  CharacterPassive[]
  inventory Inventory?
  items     ItemInstance[]
  corpses   Corpse[]
  waypointActivations CharacterWaypointActivation[]
  objectives          CharacterObjective[]
  quests              CharacterQuest[]
  chatMessages        ChatMessage[]

  @@unique([userId, characterNameNormalized])
  @@index([userId])
  @@index([originId])
  @@index([classId])
  @@index([currentZoneId])
}

model CharacterWaypointActivation {
  id          String   @id @default(uuid())
  characterId String
  waypointId  String
  zoneId      String
  activatedAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, waypointId])
  @@index([characterId])
  @@index([zoneId])
}

model CharacterStats {
  id               String   @id @default(uuid())
  characterId      String   @unique
  power            Int
  speed            Int
  mind             Int
  toughness        Int
  maxHp            Int
  damage           Int
  armor            Int
  moveSpeed        Float
  attackCooldownMs Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterPassive {
  id          String   @id @default(uuid())
  characterId String
  passiveId   String
  sourceType  String
  sourceId    String?
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, passiveId, sourceType, sourceId])
  @@index([characterId])
  @@index([passiveId])
}

model Inventory {
  id          String   @id @default(uuid())
  characterId String   @unique
  pageCount   Int      @default(1)
  gridWidth   Int      @default(10)
  gridHeight  Int      @default(6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model ItemInstance {
  id                String           @id @default(uuid())
  definitionId      String
  ownerCharacterId  String?
  locationType      ItemLocationType
  inventoryPage     Int?
  inventoryX        Int?
  inventoryY        Int?
  stashPage         Int?
  stashX            Int?
  stashY            Int?
  equipmentSlot     String?
  roomId            String?
  zoneId            String?
  positionX         Float?
  positionY         Float?
  corpseId          String?
  quantity          Int              @default(1)
  durabilityCurrent Int?
  durabilityMax     Int?
  // Milestone 0.3 -- Server-Authoritative Item Rarity & Random Affix
  // Engine. Rolled once at drop time (see affixRollEngine.ts) and
  // persisted unchanged from then on -- unlike `rarity` on the content
  // definition (a fixed per-template tag), this is the per-instance
  // rolled tier ("normal"|"magic"|"rare"|"legendary"). `rolledAffixes`
  // is a JSON-encoded `RolledAffix[]` (see affixRollEngine.ts); "[]" for
  // a normal-tier (0-affix) instance.
  rarityTier        String           @default("normal")
  rolledAffixes     String           @default("[]")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  ownerCharacter Character? @relation(fields: [ownerCharacterId], references: [id], onDelete: SetNull)
  corpse         Corpse?    @relation(fields: [corpseId], references: [id], onDelete: SetNull)

  @@index([ownerCharacterId])
  @@index([definitionId])
  @@index([locationType])
  @@index([ownerCharacterId, locationType])
  @@index([ownerCharacterId, stashPage])
  @@index([roomId])
  @@index([zoneId])
  @@index([corpseId])
}

/**
 * Milestone 0.2 — Account Stash Foundation. A stash of stackable items
 * shared across every character on the account (keyed by `userId`, not
 * `characterId`) -- deliberately a separate, simpler model from
 * `ItemInstance`'s per-character `STASH` location: only definitionId +
 * quantity are kept, so unique-instance data (durability, rolled stats)
 * is not preserved across a deposit. `slotIndex` is a stable ordering
 * key, not a positional grid coordinate.
 */
model StashItem {
  id           String   @id @default(uuid())
  userId       String
  definitionId String
  quantity     Int      @default(1)
  slotIndex    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slotIndex])
  @@unique([userId, definitionId])
  @@index([userId])
}

model CharacterObjective {
  id               String    @id @default(uuid())
  characterId      String
  objectiveId      String
  currentProgress  Int       @default(0)
  requiredProgress Int       @default(0)
  completed        Boolean   @default(false)
  rewardGranted    Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, objectiveId])
  @@index([characterId])
}

enum QuestStatus {
  ACCEPTED
  COMPLETED
}

/**
 * Core 0.1 — Persistent Quest & Dialogue System foundation. Mirrors
 * CharacterObjective's shape: one row per (character, quest), so
 * accept/complete state survives scene restarts and rejoins.
 */
model CharacterQuest {
  id          String      @id @default(uuid())
  characterId String
  questId     String
  status      QuestStatus @default(ACCEPTED)
  acceptedAt  DateTime    @default(now())
  completedAt DateTime?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, questId])
  @@index([characterId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  channel     String   @default("global")
  characterId String
  displayName String
  text        String
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
  @@index([characterId])
}

model Corpse {
  id             String       @id @default(uuid())
  characterId    String
  zoneId         String
  roomId         String?
  positionX      Float
  positionY      Float
  status         CorpseStatus @default(ACTIVE)
  forcedRecovery Boolean      @default(false)
  createdAt      DateTime     @default(now())
  recoveredAt    DateTime?

  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  items     ItemInstance[]

  @@index([characterId])
  @@index([status])
  @@index([zoneId])
}