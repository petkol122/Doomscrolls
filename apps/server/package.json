{
  "name": "@doomscrolls/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "echo server lint placeholder",
    "test": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@doomscrolls/content": "workspace:*",
    "@doomscrolls/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.19.3",
    "colyseus": "^0.17.10",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prisma": "^6.19.0",
    "tsx": "^4.22.4"
  }
}
