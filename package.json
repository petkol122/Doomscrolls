{
  "name": "doomscrolls",
  "private": true,
  "version": "0.0.0",
  "description": "Doomscrolls - browser-first online 2D isometric ARPG.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:server": "pnpm --filter @doomscrolls/server dev",
    "dev:client": "pnpm --filter @doomscrolls/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
